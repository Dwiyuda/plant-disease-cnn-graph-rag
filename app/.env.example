NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=<neo4j-username>
NEO4J_PASSWORD=<neo4j-password>
GROQ_API_KEY=<groq-api-key>
OPENROUTER_API_KEY=<openrouter-api-key>

# ── OOD / Out-of-Context Gate (LVLM guardrail, opsional) ──
# Memakai ulang OPENROUTER_API_KEY di atas. Semua baris di bawah opsional (ada default).
# OOD_GATE_MODEL=openai/gpt-4o-mini   # model vision di OpenRouter (ganti sesuai openrouter.ai/models)
# OOD_GATE_ENABLED=1                  # set 0 untuk mematikan gate (mis. demo offline)
# OOD_GATE_TIMEOUT=30                 # detik
# OOD_MAX_IMAGE_SIDE=512             # sisi terpanjang gambar yang dikirim ke LVLM
